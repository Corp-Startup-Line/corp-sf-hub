# Copy this file to .env.local and fill in real values (never commit .env.local).

# The site-wide password gate (app/lib/auth.ts). Kept as a fallback login path
# alongside Google sign-in during the rollout — see NEXT_PUBLIC_SUPABASE_*.
SITE_PASSWORD=

# HubSpot private-app token (app/api/prospects/route.ts, app/api/sf-metrics/route.ts).
# Needs CRM read scopes for deals, calls, meetings, and owners.
HUBSPOT_TOKEN=

# Upstash Redis, used for the shared manual-quote overlay and the HubSpot-pull
# caching/lock (app/lib/quoteStore.ts, app/lib/metricsStore.ts). Set up via
# Vercel -> Storage -> Create Database -> Upstash Redis (auto-fills these), or
# a direct Upstash project (then use the UPSTASH_REDIS_REST_* names instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase project (Settings -> API in the Supabase dashboard). Used for Google
# sign-in (app/lib/supabase/*, app/auth/callback/route.ts, proxy.ts). The
# Publishable key is safe to expose in the browser -- access is enforced by the
# allowlist in app/lib/allowedUsers.ts, not by keeping this key secret. Do NOT
# put the project's Secret key here (or anywhere prefixed NEXT_PUBLIC_) -- it's
# full-privilege and server-only, and this app doesn't currently need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
